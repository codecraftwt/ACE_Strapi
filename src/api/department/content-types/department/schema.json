{
  "kind": "collectionType",
  "collectionName": "departments",
  "info": {
    "singularName": "department",
    "pluralName": "departments",
    "displayName": "Department"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "deptName": {
      "type": "string"
    },
    "description": {
      "type": "blocks"
    },
    "location": {
      "type": "text"
    },
    "HeadName": {
      "type": "string"
    },
    "headProfilePhoto": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "achievements": {
      "type": "blocks"
    },
    "courses": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::course.course",
      "mappedBy": "department"
    },
    "cutoffs": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::cutoff.cutoff",
      "mappedBy": "department"
    },
    "Photos": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "Department_vision": {
      "type": "blocks"
    },
    "Department_mission": {
      "type": "blocks"
    },
    "send_emails": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::send-email.send-email",
      "mappedBy": "department"
    },
    "results": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::result.result",
      "mappedBy": "department"
    },
    "URL": {
      "type": "text"
    },
    "careerPerspective": {
      "type": "component",
      "component": "department.career-perspective",
      "repeatable": true
    },
    "quickLinks": {
      "type": "component",
      "component": "department.quick-links",
      "repeatable": true
    },
    "Baners": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "demo": {
      "type": "dynamiczone",
      "components": [
        "exam-cell.timetable",
        "exam-cell.staff",
        "exam-cell.rules-files-data",
        "exam-cell.paper-setting",
        "exam-cell.old-question-papers",
        "exam-cell.faculty-remuneration",
        "exam-cell.exam-rules-regulations",
        "exam-cell.exam-results",
        "exam-cell.exam-notice",
        "exam-cell.exam-calendar",
        "exam-cell.exam-cal-year-group",
        "exam-cell.exam-cal-file-data"
      ]
    }
  }
}
