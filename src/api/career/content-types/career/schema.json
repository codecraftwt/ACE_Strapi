{
  "kind": "collectionType",
  "collectionName": "careers",
  "info": {
    "singularName": "career",
    "pluralName": "careers",
    "displayName": "Career"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "fullName": {
      "type": "string"
    },
    "Qalification": {
      "type": "string"
    },
    "appliedPost": {
      "type": "enumeration",
      "enum": [
        "Professor",
        "Associate Professor",
        "Assistant Professor",
        "Other"
      ]
    },
    "department": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::department.department"
    },
    "email": {
      "type": "email"
    },
    "mobile": {
      "type": "string"
    },
    "address": {
      "type": "text"
    },
    "Resume": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    }
  }
}
